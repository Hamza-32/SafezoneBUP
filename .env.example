# Copy this file to .env.local and fill in real values.
# Never commit .env or .env.local: .gitignore already excludes them.
#
# On Vercel, set these in Project Settings > Environment Variables rather
# than shipping a file. JWT_SECRET in particular is required in production:
# the app refuses to sign or verify a token without it.

# ---------------------------------------------------------------------------
# Database (PostgreSQL / Supabase)
# ---------------------------------------------------------------------------
# Supabase gives you a connection string under
# Project Settings > Database > Connection string.
#
# Use the CONNECTION POOLER string, not the direct one. The pooler is what
# lets many short-lived serverless functions share a small number of real
# connections. The direct connection will run out under load.
#
# It looks like:
#   postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres
#
# The password must be URL-encoded if it contains @ : / ? # or %.
DATABASE_URL=

# Alternatively, set these instead of DATABASE_URL.
# DB_HOST=localhost
# DB_USER=postgres
# DB_PASSWORD=
# DB_NAME=postgres
# DB_PORT=5432

# Connections per pool. Every serverless instance opens its own pool, so keep
# this low. Defaults to 2 on Vercel, 10 elsewhere.
# DB_CONNECTION_LIMIT=2

# TLS is enabled automatically for any non-local host.
#
# Supabase's connection pooler presents a certificate signed by Supabase's own
# authority, which Node does not trust by default, so the connection fails
# with SELF_SIGNED_CERT_IN_CHAIN until you supply that authority. Download it
# from Project Settings > Database > SSL Configuration.
#
# Locally, point at the downloaded file:
DB_SSL_CA_FILE=supabase-ca.crt
#
# On a hosting dashboard there is no file, so paste the PEM contents instead.
# Vercel accepts multi-line values; \n escapes also work. The certificate is
# public, so it is not a secret.
# DB_SSL_CA=
#
# A local PostgreSQL usually has no TLS at all. Set this only if yours does.
# DB_SSL=true
#
# Diagnostic escape hatch. Leaves the connection encrypted but the server
# unverified, so it stops eavesdropping but not impersonation. Never leave
# it set in production.
# DB_SSL_REJECT_UNAUTHORIZED=false

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------
# REQUIRED in production, minimum 32 characters. Generate one with:
#   npm run gen:secret
# Changing this value signs every user out.
JWT_SECRET=

# How long a session lasts. Accepts any value the jsonwebtoken library takes.
JWT_EXPIRES_IN=7d

# ---------------------------------------------------------------------------
# Rate limiting
# ---------------------------------------------------------------------------
# Optional, but strongly recommended in production. Without these, rate limit
# counters live in one process's memory: on a serverless host each instance
# keeps its own and they reset on cold starts, so the limits are weak.
#
# Create a Vercel KV or Upstash Redis database and set the pair it gives you.
# Vercel KV populates KV_REST_API_* automatically when you link the store to
# the project, in which case nothing needs to be set here by hand.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
#
# Upstash outside Vercel uses these names instead:
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Password for the seeded administrator. If unset, `npm run db:seed`
# generates a random one and prints it once. Minimum 10 characters.
# SEED_ADMIN_PASSWORD=

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
NODE_ENV=development
